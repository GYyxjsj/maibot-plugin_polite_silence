{
  "manifest_version": 2,
  "id": "kitsuneimomo.polite-silence",
  "name": "礼貌性沉默",
  "version": "1.1.0",
  "description": "让 AI 通过 ignore_qq_user 工具主动沉默骚扰者：插件在设定时长内忽略指定 QQ 用户的消息，支持全局或单聊天流作用域、白名单与本地持久化。",
  "author": {
    "name": "kitsuneimomo",
    "url": "https://github.com/KitsuneiMomo"
  },
  "license": "UNLICENSED",
  "urls": {
    "repository": "https://github.com/KitsuneiMomo/astrbot_plugin_polite_silence",
    "homepage": "https://github.com/KitsuneiMomo/astrbot_plugin_polite_silence",
    "issues": "https://github.com/KitsuneiMomo/astrbot_plugin_polite_silence/issues"
  },
  "changelog": "CHANGELOG.md",
  "host_application": {
    "min_version": "1.3.0",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.6.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "plugin_type": "extension",
  "capabilities": [
    "send.text"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "display": {
    "icon": {
      "type": "local",
      "value": "assets/icon.png",
      "fallback": "volume-x"
    }
  }
}
